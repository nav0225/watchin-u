# Copy to .env (git-ignored) and fill in. Use a dedicated read-only camera user,
# never the admin/IT account.
WATCHINU_CAM01_USER=analytics
WATCHINU_CAM01_PASSWORD=change-me
# SQLite for development; PostgreSQL in production, e.g.
# postgresql+psycopg://watchinu:***@db-host:5432/watchinu
WATCHINU_DATABASE_URL=sqlite:///data/watchinu.db
TZ=Asia/Kolkata
